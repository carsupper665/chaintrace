# ChainTrace LLM Agent 設定。複製成 agent/.env。
#
# LLM 金鑰只放這裡。Go 的 .env 和前端都不該有（見 docs/development-rules.md 第 5 節）。

# gemini | codex | fake
LLM_PROVIDER=gemini
# 實測 2026-08-30 可用：gemini-3.6-flash（快）、gemini-3.5-flash-lite（最快）。
# gemini-3.7-flash 當時過載不回應；換模型比等待有效。
LLM_MODEL=gemini-3.6-flash
LLM_API_KEY=
# 注意：這個預算**包含模型思考用掉的 token**。thinking_level=low 大約吃 1000，
# 所以留給答案的比你看到的數字少。設太小會讓回覆被切一半。
LLM_MAX_TOKENS=4096

# 每次呼叫的逾時秒數。Gemini 3.x 一定會先思考再回答，證據包又大，別設太短。
LLM_TIMEOUT_SECONDS=120

# low | medium | high
# gemini-3.7-flash 不接受 minimal，會回 400。
# 我們的任務是把已經算好的結構化證據講成人話，不需要深度推理，用 low 就好。
LLM_THINKING_LEVEL=low

# Codex provider 使用本機已登入的 Codex app-server，不需要 LLM_API_KEY。
# 設 LLM_PROVIDER=codex 後，LLM_MODEL 留空會使用 Codex 的預設模型。
# Codex 會在空目錄的唯讀 sandbox 中啟動；shell、web、apps、plugins、MCP、
# subagents 等能力都停用，只有 Go 傳入的 investigation tools 可以呼叫。
CODEX_COMMAND=codex
# 留空使用該模型預設值；也可填 low / medium / high 等模型支援的 effort。
LLM_REASONING_EFFORT=

# 這個服務自己的位址。只綁內網，不對公網開放。
AGENT_HOST=127.0.0.1
AGENT_PORT=7795

# 必須跟 Go 的 .env 裡的 AGENT_SHARED_KEY 一致。對不上一律 401。
AGENT_SHARED_KEY=

# session 快取。重開就沒了是預期行為，Go 的資料庫才是 source of truth。
SESSION_TTL_SECONDS=1800
SESSION_MAX=200
