# ChainTrace backend environment.
# Copy to `.env` at the repository root. The Go server loads it via godotenv on start.
# Values already present in the OS environment win over this file.

# ---------------------------------------------------------------------------
# Mode
# ---------------------------------------------------------------------------
# APP_ENV=local|development|test relaxes production guards (SQLite fallback,
# generated secrets, generated FRONTEND_BASE_URL). Anything else — including an
# empty value with DEBUG=false — is treated as production.
APP_ENV=local
DEBUG=true

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# Port the Go server listens on. Default when unset: 7794.
PORT=7794

# Base URL that goes into the login verification email link. It must point at
# THIS Go server, not at the frontend.
#
# WARNING: the built-in default is "http://localhost:${PORT:-3000}" while the
# server's own port default is 7794. If you set neither PORT nor
# LOGIN_VERIFY_BASE_URL, the email links to http://localhost:3000 — the Next.js
# frontend, which has no /Authentication/verify route — and login can never
# complete. Always set both, or at least LOGIN_VERIFY_BASE_URL.
LOGIN_VERIFY_BASE_URL=http://localhost:7794

# Where /Authentication/verify redirects after a successful challenge, and the
# target of the catch-all NoRoute redirect. Must be the frontend origin.
# Required outside local mode; defaults to http://localhost:3000 in local mode.
FRONTEND_BASE_URL=http://localhost:3000

# Comma-separated credentialed CORS origins. Defaults to FRONTEND_BASE_URL.
# Wildcards are not accepted.
ALLOWED_ORIGINS=http://localhost:3000

# Comma-separated proxy addresses or CIDRs whose X-Forwarded-For may be believed.
# Empty (the default) trusts no proxy, so the client IP is the peer address.
# Leave empty unless a reverse proxy in front of this server sets the header
# itself; anything listed here can spoof the IP that rate limiting keys on.
TRUSTED_PROXIES=

# Request budgets per 60-second window. Unauthenticated routes (/register and
# /Authentication/*) are budgeted per client IP; protected routes are budgeted
# per authenticated Owner, because every protected request reaches the API from
# the single frontend BFF process. Set either to 0 to disable it.
GLOBAL_MAX_REQUEST_NUM=100
OWNER_MAX_REQUEST_NUM=600

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# SESSION_SECRET and JWT_SECRET are required outside local mode; in local mode
# they are generated per process (which invalidates issued tokens on restart).
SESSION_SECRET=change-me
JWT_SECRET=change-me
HMAC_SECRET=change-me
# Access-token lifetime in seconds. Default 10800 (3 hours).
TOKEN_EXPIRATION=10800

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Required outside local mode. When empty in local mode the server falls back to
# the SQLite file ./DB.db, which is not representative of production behaviour.
POSTGRES_DSN=postgres://chaintrace:chaintrace@localhost:5432/chaintrace?sslmode=disable

# Optional bootstrap Owner. All three must be set for it to be created.
ROOT_USER=
ROOT_USER_EMAIL=
ROOT_PASSWORD=

# ---------------------------------------------------------------------------
# SMTP — REQUIRED FOR LOGIN
# ---------------------------------------------------------------------------
# Login is a two-step email challenge and there is no development bypass. With
# no SMTP configuration, POST /Authentication/login fails with 500 and the
# frontend shows "登入服務暫時無法使用" — no Owner can reach the workspace, so
# every Investigation feature is unreachable.
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_SSL_ENABLED=false
SMTP_ACCOUNT=chaintrace@example.com
# Envelope sender; falls back to SMTP_ACCOUNT. Must contain "@".
SMTP_FROM=chaintrace@example.com
SMTP_TOKEN=

# ---------------------------------------------------------------------------
# TronGrid — REQUIRED FOR ANALYSIS
# ---------------------------------------------------------------------------
# Without an API key no ChainDataProvider is constructed and every Analysis Run
# terminates as failed with errorCode "provider_unavailable".
TRONGRID_API_KEY=
# Local mode only; production is pinned to https://api.trongrid.io.
TRONGRID_BASE_URL=https://api.trongrid.io
TRONGRID_HTTP_TIMEOUT_MS=10000
TRONGRID_MAX_RETRIES=2
TRONGRID_RETRY_BASE_DELAY_MS=200
TRONGRID_MAX_RETRY_DELAY_MS=2000
TRONGRID_MAX_RESPONSE_BYTES=4194304
TRONGRID_PAGE_LIMIT=200
TRONGRID_MAX_PAGES=100

# ---------------------------------------------------------------------------
# LLM Agent sidecar — OPTIONAL
# ---------------------------------------------------------------------------
# The Python Agent process. With no AGENT_BASE_URL the Go API constructs no
# AgentProvider and POST /investigations/:id/conversation keeps returning
# "agent_unavailable" while still persisting the Owner's message.
#
# The Agent must bind to a LAN or loopback address only; it is never reachable
# from the browser. See docs/development-rules.md.
AGENT_BASE_URL=http://127.0.0.1:7795
# Shared secret sent as the X-Agent-Key header. The Agent rejects any request
# without a matching value. Required whenever AGENT_BASE_URL is set.
AGENT_SHARED_KEY=
# Per-call HTTP timeout. On timeout the turn degrades to "agent_unavailable".
AGENT_HTTP_TIMEOUT_MS=30000
# Ceiling on Tier 1 tool calls the Agent may request within one turn. When the
# ceiling is hit the Go API answers from the evidence already gathered.
AGENT_MAX_TOOL_CALLS=5
# Wall-clock budget for one whole turn, including every tool round trip.
AGENT_TURN_TIMEOUT_MS=60000
# Rows any single tool call may return, so one call cannot exhaust the context.
AGENT_TOOL_MAX_ROWS=200
#
# LLM credentials live in the Python Agent's own env file, never here. The Go
# API must not hold an LLM API key.

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------
# Optional Discord webhook for panic reports.
DC_WEB_HOOK=

# Optional FGF IDP login. Register this service in the IDP admin console first.
# See ../FGF-IDP-INTEGRATION.md for the complete local setup.
# Issuer example: http://127.0.0.1:15525
# Client ID example: fgf-chaintrace
# Redirect example: http://127.0.0.1:15175/login/fgf/callback
FGF_IDP_ISSUER=
FGF_IDP_CLIENT_ID=
FGF_IDP_CLIENT_SECRET=
FGF_IDP_REDIRECT_URL=
